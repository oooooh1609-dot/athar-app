# Copy to .env and fill in. Never commit the filled file.

# ——— Supabase (from the Lovable/Supabase project settings) ———
SUPABASE_PROJECT_ID=""
SUPABASE_PROJECT_REF=""
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
# Server only. Bypasses RLS — never expose to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=""

VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# ——— Session signing (REQUIRED in production) ———
# Generate with: openssl rand -hex 32
# Without it the server refuses to sign session cookies in production. There is
# deliberately no built-in fallback: the previous fallback was derived from a
# constant in the source, which let anyone forge an administrator session.
ATHAR_SESSION_SECRET=""

# PBKDF2 hash for the legacy shared PIN, format: pbkdf2$<iterations>$<saltHex>$<hashHex>
# Leave empty to keep PIN sign-in closed (access codes remain the way in).
ATHAR_PIN_HASH=""

# ——— Local trial (laptop only) ———
# Set to 1 to run the app with no Supabase project at all. The access-code
# gate opens, and camera, enhancement, measurement, writing, projects,
# reports and search all work offline. Reading, 3D and the admin screens
# still need a real backend.
# Ignored when NODE_ENV=production or when SUPABASE_SERVICE_ROLE_KEY is set.
# NEVER set this on a deployed instance.
ATHAR_LOCAL_MODE=""
ATHAR_LOCAL_MODEL=""

# ——— AI for /api/analyze (pick ONE) ———
# The endpoint returns 503 rather than inventing a reading when none is set.
# Whichever you use, the model must support vision: it is shown photographs.

# 1. OpenAI directly — simplest for local testing.
OPENAI_API_KEY=""

# 2. Any OpenAI-compatible service: OpenRouter, Groq, Together, or a local
#    Ollama at http://localhost:11434/v1 . Both values are required.
ATHAR_AI_BASE_URL=""
ATHAR_AI_API_KEY=""

# 3. The Lovable gateway (the default inside Lovable).
LOVABLE_API_KEY=""

# Optional model override for any of the above, e.g. gpt-4o, gpt-4o-mini,
# or a provider-specific name. Defaults to gpt-4o.
ATHAR_AI_MODEL=""
