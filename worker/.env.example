# Athar companion worker configuration.
# Copy this file to .env and fill it in. Never share or commit the key.

# Your Athar app address (published or preview URL).
ATHAR_BASE_URL=https://script-stone-scribe.lovable.app

# The worker key issued in Athar: Admin → "3D processing computer" → Issue worker key.
# It is shown once. It is not the administrator password and can be revoked at any time.
ATHAR_WORKER_TOKEN=

# Full path to Meshroom's command-line program. Leave empty to auto-detect.
# Windows example: C:\Program Files\Meshroom\meshroom_batch.exe
# Linux example:   /opt/Meshroom/meshroom_batch
MESHROOM_BIN=

# Blender is used to convert Meshroom's textured OBJ to GLB. Leave empty to auto-detect.
BLENDER_BIN=

# Meshroom pipeline: leave empty for the default photogrammetry pipeline,
# or set to "draft" on computers without an NVIDIA CUDA GPU.
PIPELINE=

# How often to ask for a new job, in seconds.
POLL_SECONDS=10

# Where temporary job files live. Needs 20+ GB free per job.
WORK_DIR=

# Keep the temporary files of failed jobs for troubleshooting.
KEEP_FAILED_JOBS=false
